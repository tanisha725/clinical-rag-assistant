# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Ollama / LLM ---
# In docker-compose, this is the ollama service name. If Ollama runs on a
# remote AWS EC2 instance instead, point this at that instance's address,
# e.g. http://<ec2-public-ip>:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=codellama:7b-instruct-q4_K_M
NUM_PREDICT=300
LLM_REQUEST_TIMEOUT=120

# --- Service-to-service URLs (used by app_service) ---
RETRIEVAL_SERVICE_URL=http://retrieval_service:8000
LLM_SERVICE_URL=http://llm_service:8000
APP_REQUEST_TIMEOUT=30
APP_LLM_TIMEOUT=120

# --- Frontend ---
APP_SERVICE_URL=http://app_service:8000
FRONTEND_TIMEOUT=260
PORT=7860

# --- Retrieval / knowledge base ---
DOCS_DIR=/app/docs
VECTOR_DB_PATH=/app/chroma_db
COLLECTION_NAME=clinical_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
